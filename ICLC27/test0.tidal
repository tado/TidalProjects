-- 31-EDO helpers (n31 / ch31 / sc31 / arpSteady ...) are loaded from 31EDOtest26/31edo-main.ghci

:script 31EDOtest26/31edo-main.ghci

setcps(130/240)

hush

resetCycles

d1
  -- $ jux (("[3, 9]"/16)<~)
  $ s "supersaw(3, 16, [0, 3, 5])"
  -- # ch31 "<c:dom7 c:dom9>/4"
  # ch31 "c:wolf5s:6"
  -- # ch31 "<c:submin7>"
  |* note "[1.001, 0.999]"
  |+ note "[0, -12]"
  # pan "<0.1 0.9 0.5 0 1>*8"
  # lpf (range 800 12000 $ slow 8 $ sine) # resonance 0.3
  -- # delay 0.8 # delaytime (5/8) # delayfeedback 0.25 # lock 1
  # legato 1.0
  -- # delay 0.3 # delaytime (9/16) # delayfeedback 0.25 # lock 1
  -- # room 0.2 # size 0.8

d2
  $ s "superbass"
  # note "c3"
  |* note "[1.002, 0.998]"
  |+ note (st31 "<0 10>/4")
  # lpf 300 # resonance 0.1
  # gain 1.0

d3
  $ stack
  [
    s "uni(9, 16)" # n 1 # gain 1.2
    , s "uni(3, 8)" # gain 1.7 # legato 0.7
  ]

d4
  $ s "matsu/4"
  # legato 2.0

d5
  $ s "superzow(10, 16)"
  # sc31 "mohajira" "{0..12}%11"
  |+ note (-12)
  # pan "0 0.5 1 0 0.5 1"
  -- # delay 0.8 # delaytime (9/16) # delayfeedback 0.25 # lock 1
  # legato 0.9

d3
  $ stack
  [
    s "uni(9, 16)" # n 1
    , s "uni(4, 8)" # gain 1.5 # legato 0.5
    , s "hc(4, 8, 1)" # gain 1.5 # legato 0.5
  ]

d4
  $ s "kon(9, 16)"
  # gain 1.1

d1
  -- $ jux (("[5, 9]"/16)<~)
  $ s "supersaw(3, 16, [0, 3, 6])"
  # ch31 "<c:wolf5f:3>/8"
  |* note "[1.0001, 0.9999]"
  |+ note "[0, -12]"
  |+ note (st31 "<0 18>/8")
  # pan "<0.1 0.9>"
  # legato 1.0
  # lpf (range 400 8000 $ slow 6 $ sine) # resonance 0.3
  -- # delay 0.8 # delaytime (9/16) # delayfeedback 0.25 # lock 1

do
  resetCycles
  hush
  once
    $ s "matsu"
    |+ note "[0, -12]"
    # gain 1.0


do
  -- resetCycles
  d1
    -- $ jux (("[3, 9]"/16)<~)
    $ s "superhammond"
    # voice 7
    # ch31 "<c:dom7 c:dom9>"
    -- # ch31 "c:wolf5f:6"
    |* note "[1.001, 0.999]"
    |+ note "[0, -12]"
    |+ note (st31 "<0 10>/8")
    -- # pan "<0.1 0.9>"
    # lpf 8000 # resonance 0.3
    # room 0.5 # size 0.9
    # gain 0.6
    -- # delay 0.8 # delaytime (9/16) # delayfeedback 0.25 # lock 1  
  d2
    $ s "superhammond"
    # note "c3"
    # voice 0
    |* note "[1.002, 0.998]"
    |+ note (st31 "<0 10>/8")
    # lpf 400 # resonance 0.2
    # gain 1.0

d4
  $ s "superhammond*8"
  # voice 7
  # sc31 "mixolydian" "{0..12}%[11]"
  |+ note ("[0, -12, 12]")
  |+ note (st31 "<0 10>/8")
  # leslie 0.5 # lrate 0.5 # lsize 0.5
  # pan "0 0.5 1 0 0.5 1"
  # legato 1.2
  -- # room 0.5 # size 0.8
  # gain 0.9

d5
  $ s "superhammond*16"
  # voice 3
  # sc31 "mixolydian" "{0..12}%[11]"
  |+ note ("[0, -12, 12]")
  |+ note (st31 "<0 10>/8")
  # leslie 0.8 # lrate 0.5 # lsize 0.5
  # pan "0 0.5 1 0 0.5 1"
  # legato 0.9
  # room 0.2 # size 0.9
  # gain 0.85

d6
  $ stack
  [
    s "uni(9, 16)" # n 1
    , s "hc(4, 8, 1)" # gain 1.5 # legato 0.5
    , s "uni(4, 8)" # gain 1.4 # legato 0.5    
  ]

d2
  $ s "supermoog*4"
  # note "c3"
  |- note (st31 "<0 21>/8")
  # lpf 300 # resonance 0.2
  # legato 0.5
  -- # delay 0.5 # delaytime (5/16) # delayfeedback 0.2 # lock 1  
  # gain 1.2

d2
  $ s "supermoog(5, 16)"
  # note "c3"
  |- note (st31 "<0 21>/8")
  # lpf 330 # resonance 0.3
  # legato 2.0
  # delay 0.5 # delaytime (5/16) # delayfeedback 0.2 # lock 1  
  # gain 1.3

d1
  $ s "supersaw(5, 16, [0, 11])"
  -- # voice 7
  -- # ch31 "c:dom7 c:dom9"
  # ch31 "c:wolf5s:6"
  |* note "[1.002, 0.998]"
  |+ note "[0, -12]"
  |+ note (st31 "<0 10>/8")  
  # pan "0.1 0.5 0.9 0.1 0.5 0.9"
  # lpf (range 400 8000 $ rand) # resonance 0.2
  # gain 0.8

setcps(100/240)

resetCycles

d1
  $ s "supersin"
  # note  (st31 "[0, 10, 25]") 
  |+ note (st31 "<0 10 0 25>/2") 
  |- note (st31 "<0 21>/8")
  |+ note (st31 "<0 10 25>/16")
  |+ note (st31 "[0, -31]") 
  # room 0.5 # size 0.5
  # gain 1.0

d2
  $ s "supersin(7, 16)"
  # note  (st31 (choose[0, 10, 25])) 
  |+ note (st31 "<0 10 0 -6>/2") 
  |- note (st31 "<0 21>/8")
  |+ note (st31 "<0 10 -6>/16")
  |+ note (st31 31)
  # legato 6.0
  # delay 0.75 # delaytime (5/16) # delayfeedback 0.2 # lock 1  
  # room 0.5 # size 0.5
  # gain 0.9

d3
  $ s "supersin(11, 16)"
  # note  (st31 (choose[0, 10, 25])) 
  |+ note (st31 "<0 10 0 -6>/2") 
  |- note (st31 "<0 21>/8")
  |+ note (st31 "<0 10 -6>/16")
  -- |+ note (st31 31)
  # legato 1.0
  # delay 0.75 # delaytime (5/32) # delayfeedback 0.2 # lock 1  
  # room 0.5 # size 0.5
  # gain 0.95

d3 silence


d7
  $ s "kon(11, 16)"
  # gain 1.2

hush