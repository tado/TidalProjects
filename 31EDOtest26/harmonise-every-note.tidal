-- "Harmonising every note in 31-EDO"
-- Transcribed from the piano roll in https://www.youtube.com/shorts/fQ-YeL_sVSo (@nathan_dthomas)
-- 31 bars: a pedal C under every chord, and the top voice climbs one 31-EDO step per bar
-- (C# -> C, one octave). Numbers are 31-EDO steps above the pedal C (31 = one octave);
-- the comment after each chord gives the same notes in 31edo-main's names.

:script 31EDOtest26/31edo-main.ghci

-- everyNote31 / everyNoteAt31 / en31 / everyNoteChords31 are defined in 31edo-main

setcps (0.7)

-- start from bar 1
resetCycles

d1
  $ note (st31 everyNoteChords31)
  # s "superfm"
  # legato 1.0
  # gain 0.9

-- pick chords by bar number
d1
  $ en31 "<1 14 22 28 31>"
  # s "superfm"
  # legato 1.0
  # gain 0.9

-- numbers can be rhythmic and patterned like any Tidal pattern
d1
  $ en31 "<[13 14] [22 ~ 28] 27 [31 31 ~ 31]>"
  # s "superfm"
  # legato 1.0
  # gain 0.9

-- ── Euclidean rhythms ──────────────────────────────────

-- 1) Euclid inside the number pattern: chord 13 as 3-of-8, chord 14 as 5-of-8, ...
d1
  $ en31 "<13(3,8) 14(5,8) 22(3,8,2) 28(5,8,1)>"
  # s "superfm"
  # legato 1.0
  # gain 0.9

-- 2) Walk through all 31 chords, struck with a rotating Euclidean rhythm
d1
  $ struct "t(<3 5>,8,<0 2>)"
  $ en31 (slow 31 "1 .. 31")
  # s "superfm"
  # legato 1.0
  # gain 0.9

-- 3) Arpeggiate each chord and pick notes from it with a 16-step Euclidean rhythm
d2
  $ struct "t(<7 9>,16)"
  $ arp "<up updown>"
  $ en31 "<14 22 28 31>"
  |- note 12
  # s "superfm"
  # legato 1.0
  # pan rand
  # gain 0.8

-- 4) Euclidean drums to go with it
d3
  $ s "[bd(3,8), hh(5,8,2), ~ sn]"
  # gain 1.0

hush
