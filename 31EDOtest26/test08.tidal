setcps (140/240)
  


hush

unsolo 3

do
  -- hush
  let 
    -- shift31 = (st31 (0))    
    shift31 = (st31 "<0 -5 -10 -8 -18>/8")
    scl31 = "<major>"
    cord31 = "<c:maj7 c:maj6>"
    -- scl31 = "<minor>"
    -- cord31 = "<c:min7 c:min9>"
    -- scl31 = "<minor minor major major>/4"
    -- cord31 = "<c:min7 c:min9 c:maj6 c:maj7>/4"
  d12
    $ s "none(9, 14)"
    # td_s (choose[0..5])
  d1
    $ jux (rev)
    $ s "supervibe(5, 14, [0])"
    -- # voice 2
    # sc31 scl31 "{0..19}%[5, 9]"
    |+ note shift31
    |+ note (st31 31)
    |* note "[1.001, 0.999]"
    -- |+ note (st31 "[0, 18]")
    # legato 6.0
    -- # lpf (range 800 2000 $ rand) # resonance 0.2
    # room 0.3 # size 0.9
    # pan (rand)
    # gain 0.85  
  d2
    $ s "superbass(6, 7)"
    -- # voice 3
    # sc31 scl31 "{0..12}%5"
    |+ note shift31
    |- note (st31 62)
    |* note "[1.001, 0.999]"
    # lpf (range 400 1200 $ slow 4 $ sine) # resonance 0.3
    # gain 1.0    
  d3
    $ s "superhammond(4, 14, [0, 9])"
    # voice 5
    # ch31 cord31
    |+ note shift31
    |+ note (st31 "[0, 31]")
    # lpf (range 400 6000 $ rand) # resonance 0.3
    # room 0.5 # size 0.8    
    # gain 0.8
  
  d4
    -- $ slow 2
    $ s "supermoog(4, 7)"
    # sc31 scl31 "{0..9}%3"
    |* note "[1.001, 0.999]"
    |- note (st31 62)
    |+ note shift31
    -- |+ note (st31 "[0, 18]")
    # lpf (range 800 2000 $ rand) # resonance 0.4
    # attack 2.0 # legato 10.0 # release 0.0
    # leslie 0.9 # lrate 0.2 # lsize 0.8
    -- # room 0.5 # size 0.9
    # shape 0.95
    # gain 1.5

unsolo 3

d5
  -- $ sometimesBy 0.2 (fast 2)
  $ stack
  [ s "uni(3, 7)" # gain 1.2
    , s "uni:1(5, 7, 1)"
    , s "ifdrums(9, 14, 2)" # n (range 1 3 $ rand) # gain 1.2
  ]  
  |* gain 1.8
  -- # shape 0.8


unsolo 5

hush
