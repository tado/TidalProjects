-- ============================================================
-- 31EDO examples (evaluate the :script line below first to load the library)
-- ============================================================
-- 1 step = 1200/31 ≈ 38.7 cents. Octave = 31 steps.
--
-- ▍Quick reference (ready-to-play functions)
--   n31    "c ehf as3"                note names → single notes
--   ch31   "<c:maj f4:harm7:i>"       chord names → chords (plain notes ok too)
--   sc31   "major" "0 .. 7"           scale name + degrees → melody
--   sc31on "c" "major" "0 .. 7"       scale with a named root
--   up31 18 $ ...                     transpose in 31EDO steps (18 = fifth)
--   arpSteady 8 $ ch31 "..."          n-slot arpeggio over any chord
--   chordList31 / scaleList31         show all available chord/scale names
--
-- ▍Note name = root (c d e f g a b) + accidental + octave (default 5)
--   accidentals: s = # (+2)   f = ♭ (-2)   hs = half-# (+1)  hf = half-♭ (-1)
--                ss = ## (+4)  ff = ♭♭ (-4)
--   e.g. "c"  "ehf" (E half-flat = neutral third)  "as3" (A#3 = low harmonic 7th of C)
--
-- ▍Chord name = note name + ":" + quality + modifiers (0 or more, all ":"-separated)
--   modifiers: i / iN  = invert N times      o = open voicing
--              d / dN  = drop Nth-from-top note an octave (plain d = drop-2)
--              number N = extend/truncate to N notes (continuing up the octaves)
--   e.g. "c:maj"  "e3:harm7"  "f4:maj:i2"  "g:dom7:d"  "c:maj:6"
--
-- ▍Low-level functions (return raw 31EDO steps as Pattern Note)
--   nt31 = note names → steps    chd31 = chord names → steps
--   scale31 / scale31on = scales → steps
--   st31 = steps → note value    e31 = ControlPattern version (legacy compat)
-- ============================================================

:script 31EDOtest26/31edo-main.ghci

-- ============================================================
-- Example 1: single notes (n31) — play notes by name
-- ============================================================
-- Note name + accidental (s/f = ±2, hs/hf = ±1, ss/ff = ±4) +
-- octave (default 5). "ehf" is E half-flat (a neutral third),
-- "as" is A# (the harmonic 7th above C).

d1
  $ s "supervibe*4"
  # n31 "<c e g as ehf4 g4 c5 c6>*4"

hush

-- ============================================================
-- Example 2: chords (ch31) — call chords by name
-- ============================================================
-- Format: note name + ":" + quality (evaluate chordList31 for the
-- full list). maj → harm7 → neut → submin shifts the color of the
-- 3rd and 7th a little at a time. Roots can carry an octave
-- ("e3:maj"), and plain note names mix in freely: "c:maj e g".

d1
  $ s "superhammond"
  # ch31 "<c:maj c:harm7 c:neut c:submin>"

hush

-- ============================================================
-- Example 3: voicing modifiers — inversion, open, drop
-- ============================================================
-- Chain modifiers after the quality with ":".
--   i / i2 = invert once/twice   o = open (2nd-from-bottom up an octave)
--   d / d3 = drop 2nd/3rd-from-top an octave   number = chord size
-- Combining inversions with root octaves gives a I → IV → V7 → I
-- with minimal voice movement.

d1
  $ s "superhammond"
  # ch31 "<c:maj f4:maj:i2 g4:dom7:i c:maj>"

hush

-- The same maj7 changes character with each voicing.
d1
  $ s "superhammond"
  # ch31 "<c:maj7 c:maj7:i c:maj7:o c:maj7:d>"

hush

-- ============================================================
-- Example 4: arpeggios (arpSteady) — spread chords on a steady grid
-- ============================================================
-- arpSteady 8 divides each chord into 8 slots, cycling through the
-- chord tones from the bottom. Extending chords with ":6" ":8"
-- makes the arpeggio climb across octaves. Mixed 3- and 5-note
-- chords keep a perfectly steady rhythm.

d1
  $ arpSteady 8
  $ ch31 "<c:maj:6 f4:harm7:8 g4:dom7:6 c:harm9>"
  # s "supervibe"

hush

-- ============================================================
-- Example 5: scales (sc31 / sc31on) — write melodies as degrees
-- ============================================================
-- sc31 <scale name> <degrees> (evaluate scaleList31 for the list).
-- Degree 0 is the tonic; past the last note it folds up an octave
-- (negative degrees fold downward). Here the scale changes every
-- two cycles.

d1
  $ s "supervibe*8"
  # sc31 (slow 2 "<major mohajira orwell9 harmonics>") "0 .. 7"

hush

-- sc31on is sc31 with a named root. The scale changes every cycle
-- while the root moves c → f → g → a every four cycles, so each
-- root hosts all four scales and the whole thing loops in 16 cycles.

d1
  $ s "supervibe*8"
  # sc31on "<c f g a>/4" "<major mohajira orwell9 harmonics>" "0 .. 7"

hush

-- ============================================================
-- Example 6: transposition (up31 / st31) — move in 31EDO steps
-- ============================================================
-- up31 18 transposes up a fifth (18 steps ≈ 697¢). Combined with
-- off it becomes a fifth-above echo. Unlike 12EDO-unit shifts such
-- as |+ note 7, it stays on the 31EDO grid (only octave shifts
-- like |+ note 12 are equivalent).

d1
  $ off 0.125 (up31 18 . (|* gain 0.7))
  $ s "supervibe*4"
  # sc31 "penta5" "0 .. 3"

hush

-- st31 converts step counts to note values. With |+ note (st31 "...")
-- a whole phrase drifts in parallel — good for slow-moving drones.

d1
  $ s "supersaw"
  # n31 "<c3 c3 g2 c3>"
  |+ note (st31 "<0 8 10 5>/2")
  # legato 1.05

hush
