  # room 0.3
  # pan (rand)
  -- # legato "<0.8 1.5>*16"
  # gain 0.8

d6
  $ sometimesBy 0.2 (rev)
  $ stack
  [
    s "uni(3, 8)"
    , s "ifdrums(11, 16)" # n (range 1 3 $ rand)
    , s "uni(5, 16)" # n (range 1 2 $ rand) # pan (rand)
