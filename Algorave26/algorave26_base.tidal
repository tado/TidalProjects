  # delaytime (1/100) |* delaytime (choose [0.5, 0.75, 1.0, 1.5, 0.25])
  # delayfeedback 0.75
  # shape 0.5
  |* gain 1.4

d2
    $ jux (("[3, 5]"/16)<~)
    $ s "superhammond(9, 16, [0, 5, 9])"
    # voice 4
    # note "c4 c5"
    |+ note (scale "mixolydian" "{0..9}%[3, 5]")
    # legato 1.0
    -- # room 0.7 # size 0.9
    # gain 1.3
  
d3
  $ jux ((3/16)~>)
