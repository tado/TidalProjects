setcps(130/240)

hush

unsolo 1

do
  setcps(130/240)
  hush
  let shift = 0
  let sc = "hexDorian"
  d12
    $ s "none(5, 8)"
    # td_s (choose[4..9])
    -- # td_s "4"
  d1
    -- $ jux (("[5]"/16)<~)
    $ s "supermf(5, 16, <0..15>/8)"
    # note "c5"
    |+ note shift
    |* note "[1.001, 0.999]"
    # lpf (range 800 8000 $ slow 9 sine) 
    # resonance (range 0.1 0.3 $ slow 4 sine)
    -- # legato "<4.0 0.3>*4"
    # room 0.2 # size 0.8
    -- # delay 0.5 # delaytime (5/16) # delayfeedback 0.75 # lock 1
    # gain 1.0
  
  d2
    -- $ jux (("[12]"/16)<~)
    $ s "supermoog(5, 16, <0..15>/8)" 
    # note "c3"
    |- note "[0, 12]"
    |+ note shift
    -- # legato "<2.0 0.3>*4"
    # lpf (range 800 2000 $ slow 4 sine) # resonance 0.3
    # gain 1.0  
  
  d3
    $ stack[
      s "uni(5, 16, <0..15>/8)"
      -- , s "ifdrums(11, 16, <0..15>/8)"
    ]
    # n (range 0 3 $ rand)
    # gain 1.2
    -- # delay 0.5 # delaytime (5/14) # delayfeedback 0.75 # lock 1
  
  d4
    $ s "superbass(7, 16, <0..15>/8)"
    # note "c3"
    |+ note (scale sc "{0..12}%3")
    |+ note shift
    -- |+ note "[0, 7]"
    -- |* speed "[1.001, 0.999]"
    -- # legato 1.0
    # lpf (range 2000 8000 $ slow 4 sine) # resonance 0.1
    # gain 1.1
  
  d5
    $ s "supersaw(9, 16)"
    # note "c2"
    # legato 2.0
    |+ note (scale sc "{0..12}%5")
    |+ note shift
    # lpf (range 800 8000 $ rand) # resonance 0.3
    # voice 0.2
    # gain 1.1
  
  d6
    $ slow 2
    $ s "supermoog(3, 8)"
    # note "c2"
    |+ note "[-0.04, 0.04]"
    |+ note (scale "hexAeolian" "{0..9}%3")
    |+ note shift
    # lpf (range 100 2000 $ rand) # resonance 0.3
    # attack 2 # sustain 2
    -- # leslie 0.5 # lrate 0.2 # lsize 0.8
    -- # room 0.1 # size 0.9
    # gain 1.3

d3
  -- $ sometimesBy 0.2 (rev)
  -- $ jux ((5/16)~>)
  $ stack
  [
    s "uni(3, 8)" # gain 1.8
    -- , s "ifdrums(9, 16)" # n (range 1 3 $ rand)
    -- , s "uni(5, 16)" # n (range 1 2 $ rand) # pan (rand)
    -- , s "hc(9, 16, 4)" # gain 0.8
    -- , s "fell(9, 16, 1)" # n (irand 8)
  ]
  # delay 0.5
  # delaytime (1/100) |* delaytime (choose [0.5, 0.75, 1.0, 1.5, 0.25])
  # delayfeedback 0.75
  # shape 0.7
  |* gain 1.5

d5
  -- $ jux (("3, 9"/16)~>)
  $ s "supersaw(5, 16)"
  # note "c5"
  -- |+ note "[0, 12]"
  |+ note "0, <5 7 9 12 14 19>/4"
  |+ note "c'sus2"
  # voice 0.2
  # lpf (range 800 8000 $ slow 4 sine) # resonance 0.2
  # delay 0.5 # delaytime ("5, 9"/16) # delayfeedback 0.5 # lock 1
  # room 0.3
  # pan (rand)
  -- # legato "<0.8 1.5>*16"
  # gain 0.8

d2
  $ s "superbass(9, 16)"
  # note "c2"
  # legato 1.0
  |+ note (scale "hexDorian" "{0..19}%5")
  # lpf (range 800 8000 $ rand) # resonance 0.3
  # voice 0.2
  # gain 1.1

---

do
  hush
