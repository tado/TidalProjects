  # gain 1.1

d4
  $ s "hasu(11, 16)"
  # n (irand 100)
  -- |+ note 12
  -- # room 0.3
  # gain 1.3

d7
  -- $ jux (("3, 9"/16)~>)
  $ s "supersaw(9, 16)"
  # note "c5"
  -- |+ note "[0, 12]"
  |+ note "0, <5 7 9 12 14 19>/4"
  |+ note "c'sus2"
  # voice 0.2
  # lpf (range 800 8000 $ slow 4 sine) # resonance 0.2
  -- # delay 0.5 # delaytime ("5, 9"/16) # delayfeedback 0.5 # lock 1
  # room 0.3
  # pan (rand)
  -- # legato "<0.8 1.5>*16"
  # gain 0.8

d5
  $ sometimesBy 0.2 (rev)
  $ stack
  [
    s "uni(3, 8)"
    , s "ifdrums(11, 16)" # n (range 1 3 $ rand)
    , s "uni(5, 16)" # n (range 1 2 $ rand) # pan (rand)
    , s "hc(16, 16, 4)" # gain 0.8
    -- , s "uni:1(7, 16, 2)"
    , s "fell(9, 16, 1)" # n (irand 8)
  ]
  # delay 0.9
  # delaytime (1/100) |* delaytime (choose [0.5, 0.75, 1.0, 1.5, 0.25])
  # delayfeedback 0.75
  # shape 0.5
  |* gain 1.4

do
