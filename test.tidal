-- Rhythm boost: 現在の d1-d3 に重ねる、跳ねた 16 分 + 変則アクセント
-- この do ブロックをまとめて評価
do
  let shift = "<0 0 1 2 3>/4"
  d4
    $ swingBy (1/24) 4
    $ every 4 (jux (iter 4))
    $ sometimesBy 0.18 (fast 2)
    $ stack
    [
      s "bd(3, 8, 2)" # gain "<1.25 0.9 1.1>*4"
      , s "cp(2, 8, 4)" # gain 1.0
      , s "hc(11, 16, 5)" # gain "<0.9 0.35 0.65 0.45>*4" # pan "<0.35 0.65>*8"
      , s "rs(5, 16, 3)" # gain 0.75 # shape 0.35
      , sometimesBy 0.25 (fast 2) $ s "ifdrums(3, 16, 11)" # n (irand 4) # gain 0.65
    ]
    # shape 0.25
    # delay 0.35 # delaytime (3/16) # delayfeedback 0.4 # lock 1
    # room 0.2 # size 0.4
  d5
    $ swingBy (1/24) 4
    $ every 8 (fast 2)
    $ sometimesBy 0.12 (rev)
    $ s "superbass(5, 16, 3)"
    # note "c1"
    |+ note (scale "yu" "<0 0 4 2 1 3 0 5>")
    |+ note shift
    # legato "<0.7 0.25 0.5 0.3>*4"
    # lpf (range 180 1800 $ slow 4 $ sine) # resonance 0.35
    # shape 0.45
    # gain "<1.15 0.9 1.05 1.25>*4"
  d6
    $ swingBy (1/24) 4
    $ every 4 (jux (rev))
    $ sometimesBy 0.2 (fast 2)
    $ s "superzow(13, 16, 5)"
    # note "c1"
    |+ note (scale "yu" "<0 0 4 1 5 2 6 3>")
    |+ note "<0 -12 0 7>/4"
    |+ note shift
    # legato "<0.18 0.08 0.32 0.12>*4"
    # lpf (range 260 4200 $ slow 2 $ sine) # resonance 0.62
    # shape 0.78
    # delay 0.18 # delaytime (1/16) # delayfeedback 0.25 # lock 1
    # gain "<1.15 0.8 1.3 0.95>*4"

-- リズム追加分だけ止める
-- d4 silence >> d5 silence >> d6 silence


-- Lead melody: 現在の d1-d3 に重ねる主旋律と応答
-- d1-d3 と同じ yu 音階・同じ shift に乗るので和音進行から外れない。
-- 主旋律 d7 は 8 サイクルかけて上昇するテーマ、d8 はその隙間に入る応答。
-- off (3/16) の 1 オクターブ上のエコーが旋律の影として付いてくる。
-- この do ブロックをまとめて評価する。
do
  let shift  = "<0 0 1 2 3>/4"
      lead   = "<[0 ~ 2 3] [4 ~ 3 2] [3 5 ~ 7] [5 ~ 4 [3 2]] [2 ~ 4 5] [7 ~ [8 7] 5] [4 5 ~ [7 8]] [10 ~ 7 ~]>"
      answer = "<~ [~ 7 ~ 5] ~ [~ 4 ~ 3] ~ [~ 10 ~ 8] ~ [~ 7 [5 4] ~]>"
  d7
    $ swingBy (1/24) 4
    $ every 8 (fast 2)
    $ every 3 (jux ((3/16)<~))
    $ sometimesBy 0.15 (ply 2)
    $ off (3/16) ((|+ note 12) . (# legato 0.25) . (# gain 0.5))
    $ note (scale "yu" lead |+ "c5" |+ shift |+ "[-0.03, 0.03]")
    # s "superfork"
    # legato "<0.9 0.35 0.6 [1.2 0.3]>*4"
    # lpf (range 1200 7000 $ slow 6 $ sine) # resonance 0.25
    # delay 0.4 # delaytime (3/16) # delayfeedback 0.45 # lock 1
    # room 0.4 # size 0.9
    # gain "<1.05 0.85 1.0 0.9>*4"
  d8
    $ swingBy (1/24) 4
    $ every 4 (rev)
    $ jux ((5/16)~>)
    $ note (scale "yu" answer |+ "c6" |+ shift |+ "[0, -12]" |+ "[-0.04, 0.04]")
    # s "superwho"
    # legato "<1.6 0.7 1.1 0.5>*4"
    # lpf (range 900 5000 $ slow 9 $ sine) # resonance 0.3
    # delay 0.3 # delaytime (5/16) # delayfeedback 0.35 # lock 1
    # room 0.55 # size 0.95
    # gain 0.7

-- メロディーを煽る(クライマックス用・上のブロックの後で評価)
-- 16 分の走句が増え、8 サイクルごとに 1 オクターブ跳ね上がる。
d7
  $ swingBy (1/24) 4
  $ every 4 (fast 2)
  $ every 3 (jux (iter 4))
  $ sometimesBy 0.3 (ply "<2 3>")
  $ off (3/16) ((|+ note 12) . (# legato 0.2) . (# gain 0.55))
  $ note (scale "yu"
      "<[0 2 3 5] [7 ~ 5 [4 3]] [5 7 8 10] [12 ~ 10 [8 7]] [8 ~ 7 5] [4 5 7 [8 10]] [12 10 ~ [8 7]] [5 ~ [3 2] 0]>"
      |+ "c5" |+ "<0 0 1 2 3>/4" |+ "<0 0 12 0>/8" |+ "[-0.03, 0.03]")
  # s "superfork"
  # legato "<0.55 0.25 0.4 [0.9 0.2]>*4"
  # lpf (range 1800 9000 $ slow 4 $ sine) # resonance 0.35
  # shape 0.25
  # delay 0.5 # delaytime (3/16) # delayfeedback 0.55 # lock 1
  # room 0.35 # size 0.9
  # gain "<1.2 0.9 1.1 0.95>*4"

-- メロディーだけ止める
-- d7 silence >> d8 silence
